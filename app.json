{
  "expo": {
    "name": "streepje",
    "slug": "streeplijst",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "streepje",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "nl.scoutingjwf.streepje"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161616",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.scoutingjwf.streepje",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "streepje gebruikt de camera alleen om de QR-code te scannen waarmee je een gedeelde lijst opent.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161616",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "980bc886-c437-4e7e-b546-acf656335999"
      }
    }
  }
}
